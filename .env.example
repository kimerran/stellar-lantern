# Build-time feature flags (#81) — see src/shared/flags.ts.
#
# Booleans only (never secrets). Unset takes the safe default shown below;
# "true" or "1" turns a flag ON, anything else turns it OFF. Copy to `.env`
# (uncommitted) or set in CI to build a lean store bundle vs a WIP canary.
# Disabled features can dead-code-eliminate out of the bundle.

# Swap screen + SDEX/path-payment engine (shipped, #71).       default: ON
# VITE_FEATURE_SWAP=true

# Soroswap aggregator engine — best-price routing across Soroswap/Aqua/
# Phoenix/SDEX via the Soroswap API (#71). default: ON, but fail-soft: without
# the API key below the Swap screen falls back to the native SDEX engine.
# VITE_FEATURE_SWAP_AGGREGATOR=true
#
# --- Soroswap API config (secrets/values, NOT feature flags) ---
# Bearer API key from https://api.soroswap.finance (required for the aggregator).
# VITE_SOROSWAP_API_KEY=
# Optional revenue share: your referral wallet address (G...) + fee in basis
# points (50 = 0.5%). The fee is only sent when BOTH are set (the API requires
# a referral wallet whenever a fee is charged).
# VITE_SOROSWAP_REFERRAL_ID=
# VITE_SOROSWAP_FEE_BPS=50

# Earn / Blend supply-withdraw (shipped, #21).                  default: ON
# VITE_FEATURE_EARN_BLEND=true

# Anchor Cash in / Cash out (shipped, #24).                     default: ON
# VITE_FEATURE_ANCHORS=true

# Biometric unlock (#23 M2a). ON: works on Android (Keystore adapter); inert on
# web/extension (store reports unavailable until a WebAuthn-PRF adapter).  default: ON
# VITE_FEATURE_BIOMETRIC_UNLOCK=true

# Geo-velocity / impossible-travel risk signal (#70) —
# needs an external Cloudflare Worker.                          default: OFF
# VITE_FEATURE_GEOVELOCITY=false

# dApp mini-apps browser (shipped).                             default: ON
# VITE_FEATURE_MINIAPPS=true

# Demo-only affordances (forceScenario, demo deny-list) —
# keep OFF in production/store builds.                          default: OFF
# VITE_FEATURE_DEMO_AFFORDANCES=false

# Passkey smart accounts (#53) — seed-phrase-free Soroban account signed by a
# device passkey. Testnet-only, experimental.                   default: OFF
# VITE_FEATURE_PASSKEY=false

# Scanner AI explainer (#59) — one hosted LLM writes the plain-English sentence
# about a scanned transaction. It never decides the verdict (deterministic
# code does), so this is OFF by default and the wallet stays fully useful
# without it. The release and Android workflows turn it ON (#84) and point
# it at the Lantern API below; local builds default OFF.        default: OFF
# VITE_FEATURE_SCANNER_AI=false
#
# --- Lantern API base (a URL, NOT a secret) ---
# Where the wallet's pre-sign review fetches the AI sentence from (#84):
# `${VITE_LANTERN_API_URL}/v1/explain`, key held server-side. Only read when
# the flag above is ON; with it OFF the URL is not in the bundle at all. Its
# origin is in manifest host_permissions.
# VITE_LANTERN_API_URL=https://lantern-api-production-3fad.up.railway.app
#
# --- Scanner AI config (a secret, NOT a feature flag) ---
# Anthropic API key. Deliberately NOT a VITE_* variable: VITE_* values are
# inlined into the built bundle, and a billing-bearing key must never ship in
# an extension anyone can unzip. The wallet composition is
# src/core/scan/ai.ts (hostedExplainer); the wallet's pre-sign review uses the
# proxy endpoint above (src/core/scan/wallet.ts), never a key.
# CI never sets it — the suite is green offline by design.
# LANTERN_AI_API_KEY=
# Model, recorded for the D2 evidence package (SOW: "a single hosted LLM").
# LANTERN_AI_MODEL=claude-haiku-4-5-20251001
# In any shipped build the key stays server-side: point the wallet at the
# Lantern API instead (services/lantern-api, POST /v1/explain) via
# hostedExplainer({ endpoint }). The key above is for local dev only.

# Opt-in usage analytics (#81) — an anonymous install id + enum-only events,
# sent only after the user turns it on in Settings. OFF by default: with the
# flag off no telemetry code or ingest origin is in the bundle.  default: OFF
# VITE_FEATURE_TELEMETRY=false
#
# --- Telemetry config (a value, NOT a feature flag) ---
# The ingest endpoint the sink POSTs envelopes to — the Lantern API on Railway
# (services/lantern-api). Its origin is listed in manifest host_permissions;
# the release and Android workflows set both the flag and this URL.
# VITE_TELEMETRY_INGEST_URL=https://lantern-api-production-3fad.up.railway.app/v1/telemetry
