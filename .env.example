# Build-time feature flags (#81) — see src/shared/flags.ts.
#
# Booleans only (never secrets). Unset takes the safe default shown below;
# "true" or "1" turns a flag ON, anything else turns it OFF. Copy to `.env`
# (uncommitted) or set in CI to build a lean store bundle vs a WIP canary.
# Disabled features can dead-code-eliminate out of the bundle.

# Swap screen + SDEX/path-payment engine (shipped, #71).       default: ON
# VITE_FEATURE_SWAP=true

# Soroswap aggregator engine — external API, not built yet (#71). default: OFF
# VITE_FEATURE_SWAP_AGGREGATOR=false

# Earn / Blend supply-withdraw (shipped, #21).                  default: ON
# VITE_FEATURE_EARN_BLEND=true

# Anchor Cash in / Cash out (shipped, #24).                     default: ON
# VITE_FEATURE_ANCHORS=true

# Biometric unlock (#23 M2a) — native adapter device-unverified. default: OFF
# VITE_FEATURE_BIOMETRIC_UNLOCK=false

# Geo-velocity / impossible-travel risk signal (#70) —
# needs an external Cloudflare Worker.                          default: OFF
# VITE_FEATURE_GEOVELOCITY=false

# dApp mini-apps browser (shipped).                             default: ON
# VITE_FEATURE_MINIAPPS=true

# Demo-only affordances (forceScenario, demo deny-list) —
# keep OFF in production/store builds.                          default: OFF
# VITE_FEATURE_DEMO_AFFORDANCES=false

# Passkey smart accounts (#53) — seed-phrase-free Soroban account signed by a
# device passkey. Testnet-only, experimental.                   default: OFF
# VITE_FEATURE_PASSKEY=false
