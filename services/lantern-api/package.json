{
  "name": "@lantern/api",
  "version": "0.1.0",
  "private": true,
  "description": "Lantern API — the backend that holds keys so clients never do. First route: the scanner explainer's LLM proxy.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --define:__FEATURE_DEMO_AFFORDANCES__=false --alias:@lantern/scanner=../../packages/lantern-scanner/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.6.14",
    "@hono/node-server": "1.13.7"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "typescript": "5.7.2",
    "vitest": "4.1.8",
    "@types/node": "22.10.2"
  }
}
